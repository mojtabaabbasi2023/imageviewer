{
  "name": "@mojtabaabbasi/image-viewer",
  "version": "1.1.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojtabaabbasi2023/imageviewer.git"
  },
  "homepage": "https://mojtabaabbasi2023.github.io/imageviewer",
  "main": "dist/image-viewer.umd.js",
  "module": "dist/image-viewer.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/image-viewer.es.js",
      "require": "./dist/image-viewer.umd.js"
    },
    "./image-viewer.css": "./dist/image-viewer.css"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.json",
    "build:demo": "vite build -c vite.config.deploy.ts",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  },
  "keywords": [
    "vue",
    "vue3",
    "image-viewer",
    "image-gallery",
    "point-zoom",
    "photo-viewer",
    "book-page-viewer",
    "book-viewer",
    "typescript"
  ]
}
